# ==============================================================================
# TaskFlow Environment Configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real .env file - it's in .gitignore.
# ==============================================================================

# --- MySQL Database ---
# Root password (admin access to MySQL)
MYSQL_ROOT_PASSWORD=change-me-root-password
# Application database name
MYSQL_DB=taskflow
# Application database user (non-root, used by the app)
MYSQL_USER=taskflow_user
# Password for the application database user
MYSQL_PASSWORD=change-me-app-password

# --- Flask Application ---
# Environment: development or production
FLASK_ENV=production
# Secret key for session signing - generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- Application ---
APP_PORT=5000
